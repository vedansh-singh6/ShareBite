# Frontend environment. Copy to .env (or .env.local).
#
# API_MODE:
#   mock  → centralized mock data + service layer (default, no backend needed)
#   flask → talk to the Flask API at /api (proxied to 127.0.0.1:5000 in dev)
VITE_API_MODE=mock

# Base URL for the Flask API. In dev, Vite proxies /api to 127.0.0.1:5000.
VITE_API_BASE_URL=/api